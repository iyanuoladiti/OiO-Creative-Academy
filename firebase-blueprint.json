{
  "entities": {
    "userProfile": {
      "title": "User Profile",
      "description": "Student or Admin account information, enrollment status, and contact details",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 100 },
        "whatsapp": { "type": "string", "maxLength": 25 },
        "role": { "type": "string", "enum": ["student", "admin"] },
        "enrollmentStatus": { "type": "string", "enum": ["pending", "enrolled", "rejected"] },
        "enrolledAt": { "type": "string", "maxLength": 50 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["uid", "email", "displayName", "role", "enrollmentStatus", "createdAt"]
    },
    "classSession": {
      "title": "Class Session",
      "description": "Live class session with dedicated Google Meet URL and optional YouTube stream",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "date": { "type": "string", "maxLength": 50 },
        "startTime": { "type": "string", "maxLength": 20 },
        "endTime": { "type": "string", "maxLength": 20 },
        "meetUrl": { "type": "string", "maxLength": 300 },
        "youtubeLiveId": { "type": "string", "maxLength": 100 },
        "instructorNote": { "type": "string", "maxLength": 1000 },
        "order": { "type": "number" },
        "status": { "type": "string", "enum": ["scheduled", "live", "completed"] },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["title", "date", "startTime", "meetUrl", "order"]
    },
    "recording": {
      "title": "Recording",
      "description": "Archived past session recording with YouTube embed ID and session notes",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "sessionDate": { "type": "string", "maxLength": 50 },
        "youtubeId": { "type": "string", "maxLength": 100 },
        "summary": { "type": "string", "maxLength": 2000 },
        "duration": { "type": "string", "maxLength": 50 },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["title", "youtubeId", "order"]
    },
    "material": {
      "title": "Learning Material",
      "description": "Resource links, downloadable files, sample footage, shortcuts, and cheat sheets",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "category": { "type": "string", "maxLength": 100 },
        "url": { "type": "string", "maxLength": 500 },
        "fileType": { "type": "string", "maxLength": 50 },
        "lessonNumber": { "type": "number" },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["title", "category", "url", "order"]
    },
    "announcement": {
      "title": "Announcement",
      "description": "Notice broadcast to all students dashboard",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "content": { "type": "string", "maxLength": 2000 },
        "priority": { "type": "string", "enum": ["normal", "urgent"] },
        "authorName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["title", "content", "priority", "createdAt"]
    },
    "paymentRecord": {
      "title": "Payment Record",
      "description": "Student payment proof and transaction status",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 256 },
        "userName": { "type": "string", "maxLength": 100 },
        "amountKobo": { "type": "number" },
        "amountNaira": { "type": "number" },
        "mode": { "type": "string", "enum": ["manual", "paystack"] },
        "reference": { "type": "string", "maxLength": 120 },
        "status": { "type": "string", "enum": ["pending", "verified", "rejected"] },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "userEmail", "amountNaira", "mode", "reference", "status", "createdAt"]
    },
    "admin": {
      "title": "Admin Record",
      "description": "Registry of authorized admin users",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 256 },
        "name": { "type": "string", "maxLength": 100 },
        "addedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["email", "addedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/userProfile" },
      "description": "Private user profile and enrollment state"
    },
    "/classes/{classId}": {
      "schema": { "$ref": "#/entities/classSession" },
      "description": "Scheduled live classes with Google Meet links for enrolled students"
    },
    "/recordings/{recordingId}": {
      "schema": { "$ref": "#/entities/recording" },
      "description": "Past class recordings for enrolled students"
    },
    "/materials/{materialId}": {
      "schema": { "$ref": "#/entities/material" },
      "description": "Course materials, project files, and resource links"
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/announcement" },
      "description": "Academy notices and schedule reminders"
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/paymentRecord" },
      "description": "Manual transfer references and Paystack payment records"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/admin" },
      "description": "Trusted admin UID lookup records"
    }
  }
}
