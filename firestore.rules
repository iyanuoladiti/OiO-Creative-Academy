rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'oladitiiyanu@gmail.com' ||
        request.auth.token.email == 'oioserviceshq@gmail.com'
      );
    }

    function isEnrolled() {
      return isAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.enrollmentStatus == 'enrolled'
      );
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (
        isSignedIn() &&
        (request.auth.token.email == 'oladitiiyanu@gmail.com' || request.auth.token.email == 'oioserviceshq@gmail.com') &&
        request.auth.uid == adminId
      );
    }

    // User profiles & enrollment status
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      // Self-registration: students can create their own account with pending status, or admins can create with admin status
      allow create: if isOwner(userId) &&
        request.resource.data.uid == request.auth.uid &&
        (
          isAdmin() ||
          (request.resource.data.role == 'student' && request.resource.data.enrollmentStatus == 'pending')
        );

      // Updates: Admins can update any field (e.g. approve/enroll/reject).
      // Students can only update their profile fields (displayName, whatsapp) without elevating privileges.
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'enrollmentStatus', 'enrolledAt', 'uid', 'email'])
      );

      allow delete: if isAdmin();
    }

    // Live classes (Google Meet links) - accessible only to enrolled students and admins
    match /classes/{classId} {
      allow read: if isEnrolled();
      allow write: if isAdmin();
    }

    // Past recordings - accessible only to enrolled students and admins
    match /recordings/{recordingId} {
      allow read: if isEnrolled();
      allow write: if isAdmin();
    }

    // Learning materials and files - accessible only to enrolled students and admins
    match /materials/{materialId} {
      allow read: if isEnrolled();
      allow write: if isAdmin();
    }

    // Announcements - accessible to any signed-in student
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Payment proof and transaction logs
    match /payments/{paymentId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
